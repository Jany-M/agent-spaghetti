{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "roo",
  "name": "Roo Code",
  "roles": [
    "client"
  ],
  "cost": "unknown",
  "detect": {
    "paths": [
      "~/.vscode/extensions/rooveterinaryinc.roo-cline-*",
      "~/.vscode-insiders/extensions/rooveterinaryinc.roo-cline-*",
      "~/.cursor/extensions/rooveterinaryinc.roo-cline-*",
      "~/.windsurf/extensions/rooveterinaryinc.roo-cline-*"
    ],
    "version": {
      "file": "~/.vscode/extensions/rooveterinaryinc.roo-cline-*/package.json",
      "json": "version"
    }
  },
  "speaks": {
    "openaiClient": {
      "setup": "In Roo Code's settings: API Provider = OpenAI Compatible, Base URL = {url}, API Key = {key}, Model = auto.\nWhich LLM answers is chosen in Agent Spaghetti (Tools \u2192 Roo Code \u2192 Model). The model must support tool calls for agent work."
    }
  }
}
