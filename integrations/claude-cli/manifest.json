{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "claude-cli",
  "name": "Claude Code CLI",
  "color": "#ea580c",
  "roles": [
    "agent",
    "client"
  ],
  "cost": "metered",
  "detect": {
    "bin": [
      "claude"
    ],
    "paths": {
      "windows": [
        "~/.local/bin/claude.exe"
      ],
      "linux": [
        "~/.local/bin/claude"
      ],
      "macos": [
        "~/.local/bin/claude"
      ]
    },
    "version": {
      "args": [
        "--version"
      ]
    }
  },
  "speaks": {
    "mcpClientNames": ["claude-code"],
    "agentFile": "~/.claude/agents/agent-spaghetti.md",
    "mcpClient": {
      "config": "~/.claude.json",
      "key": "mcpServers"
    },
    "mcpCli": {
      "add": [
        "mcp",
        "add",
        "--scope",
        "user"
      ],
      "remove": [
        "mcp",
        "remove",
        "--scope",
        "user"
      ]
    },
    "promptHook": {
      "config": "~/.claude/settings.json",
      "event": "UserPromptSubmit"
    }
  }
}
