// Applied by OpenClaw's setup (integrations/openclaw/pack/setup.ts) with `openclaw config patch` (objects merge, arrays replace).
// Provider/model/timeout and MCP parking are a second, generated patch. {{STATE}} and {{ORCH}} are filled in by the setup.
{
  agents: {
    defaults: {
      // One orchestrator turn + one child at most. The LLM backend has a single slot.
      maxConcurrent: 2,
      timeoutSeconds: 1800,
      // Recurring heartbeat competes for the same slot and does nothing useful here (target: none).
      heartbeat: { every: "0m", target: "none" },
      subagents: {
        maxConcurrent: 1,
        maxSpawnDepth: 1, // flat: orchestrator -> worker. Workers never spawn.
        maxChildrenPerAgent: 12,
        delegationMode: "prefer",
        runTimeoutSeconds: 1500,
      },
    },
    entries: {
      // Your default agent ({{ORCH}}) becomes the orchestrator: lean tools only.
      {{ORCH}}: {
        subagents: {
          allowAgents: ["worker", "toolsmith", "verifier"],
          requireAgentId: true,
        },
        tools: {
          profile: "minimal",
          alsoAllow: [
            "group:sessions",
            "agents_list",
            "agents_wait",
            "read",
            "write",
            "edit",
            "exec",
            "memory_search",
            "memory_get",
            "automations",
            "ask_user",
          ],
        },
      },
      worker: {
        name: "worker",
        workspace: "{{STATE}}/workspace-worker",
        agentDir: "{{STATE}}/agents/worker/agent",
        identity: { name: "Worker", emoji: "🔧" },
        tools: { profile: "coding", deny: ["sessions_spawn", "subagents"] },
      },
      toolsmith: {
        name: "toolsmith",
        workspace: "{{STATE}}/workspace-toolsmith",
        agentDir: "{{STATE}}/agents/toolsmith/agent",
        identity: { name: "Toolsmith", emoji: "🧰" },
        tools: { profile: "coding", deny: ["sessions_spawn", "subagents"] },
      },
      verifier: {
        name: "verifier",
        workspace: "{{STATE}}/workspace-verifier",
        agentDir: "{{STATE}}/agents/verifier/agent",
        identity: { name: "Verifier", emoji: "✅" },
        tools: { profile: "minimal", alsoAllow: ["read", "exec"] },
      },
    },
  },
  tools: {
    // Core tools are exposed directly (no tool_call{id,args} wrapper that small models mis-nest).
    // Safe because the orchestrator tool set is tiny and MCP servers are parked.
    toolSearch: false,
  },
}
