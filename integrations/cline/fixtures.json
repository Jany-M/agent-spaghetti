[
  {
    "name": "desktop app (uninstall entry + process), not connected yet",
    "env": {
      "inventory": {
        "installed": [
          {
            "name": "Cline",
            "version": "0.0.46",
            "location": "C:/Users/u/AppData/Local/Cline",
            "source": "uninstall"
          }
        ],
        "processes": [
          {
            "name": "cline-app",
            "pid": 4,
            "path": "C:/Users/u/AppData/Local/Cline/cline-app.exe"
          }
        ]
      }
    },
    "expect": {
      "version": "0.0.46",
      "installs": 2,
      "connected": false
    }
  },
  {
    "name": "found",
    "env": {
      "files": {
        "~/.vscode/extensions/saoudrizwan.claude-dev-*": "",
        "~/.vscode/extensions/saoudrizwan.claude-dev-*/package.json": "{\"version\":\"3.1.0\"}"
      }
    },
    "expect": {
      "installs": 1,
      "version": "3.1.0"
    }
  },
  {
    "name": "set to a free OpenRouter model: free, shown",
    "env": {
      "files": {
        "~/.vscode/extensions/saoudrizwan.claude-dev-*": "",
        "~/.cline/data/settings/providers.json": "{\"lastUsedProvider\":\"or\",\"providers\":{\"or\":{\"settings\":{\"provider\":\"openrouter\",\"apiKey\":\"k\",\"model\":\"vendor/m-1:free\"}}}}"
      }
    },
    "expect": {
      "cost": "free",
      "why": "set to openrouter · vendor/m-1:free",
      "absent": [
        "\"k\""
      ]
    }
  },
  {
    "name": "set to a model that is not free: unknown (asks first)",
    "env": {
      "files": {
        "~/.vscode/extensions/saoudrizwan.claude-dev-*": "",
        "~/.cline/data/settings/providers.json": "{\"lastUsedProvider\":\"p\",\"providers\":{\"p\":{\"settings\":{\"provider\":\"paid\",\"model\":\"big\"}}}}"
      }
    },
    "expect": {
      "cost": "unknown"
    }
  },
  {
    "name": "nothing set: no free option documented, cost as the manifest says",
    "env": {
      "files": {
        "~/.vscode/extensions/saoudrizwan.claude-dev-*": ""
      }
    },
    "expect": {
      "cost": "unknown"
    }
  },
  {
    "name": "absent",
    "env": {},
    "expect": null
  }
]
