{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "cline",
  "name": "Cline",
  "roles": [
    "agent",
    "client"
  ],
  "cost": "unknown",
  "detect": {
    "installed": [
      "Cline"
    ],
    "process": [
      "cline-app",
      "cline"
    ],
    "bin": [
      "cline"
    ],
    "paths": [
      "~/.vscode/extensions/saoudrizwan.claude-dev-*",
      "~/.vscode-insiders/extensions/saoudrizwan.claude-dev-*",
      "~/.cursor/extensions/saoudrizwan.claude-dev-*",
      "~/.windsurf/extensions/saoudrizwan.claude-dev-*"
    ],
    "version": {
      "file": "~/.vscode/extensions/saoudrizwan.claude-dev-*/package.json",
      "json": "version"
    }
  },
  "speaks": {
    "acp": {
      "command": [
        "cline",
        "--acp"
      ]
    },
    "mcpClient": {
      "config": "~/.cline/data/settings/cline_mcp_settings.json",
      "key": "mcpServers"
    }
  }
}
