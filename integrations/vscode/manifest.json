{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "vscode",
  "name": "VS Code",
  "abilities": [
    "web"
  ],
  "roles": [
    "client"
  ],
  "cost": "unknown",
  "detect": {
    "installed": [
      "Microsoft Visual Studio Code*"
    ],
    "process": [
      "Code"
    ],
    "bin": [
      "code"
    ],
    "version": {
      "from": "installed"
    }
  },
  "speaks": {
    "chat": {
      "command": [
        "code",
        "chat",
        "-m",
        "agent",
        "-r"
      ]
    },
    "mcpClientNames": [
      "Visual Studio Code",
      "copilot-cli"
    ],
    "agentFile": "~/.copilot/agents/agent-spaghetti.agent.md",
    "agentModel": "['Agent Spaghetti (customendpoint)']",
    "agentTools": "['agent-spaghetti/*']",
    "mcpClient": {
      "config": "~/.copilot/mcp-config.json",
      "key": "mcpServers",
      "entry": {
        "type": "local",
        "tools": [
          "*"
        ]
      }
    },
    "openaiClient": {
      "setup": "Connect VS Code in Agent Spaghetti (Tools) and this is done for you. By hand: Chat: Manage Language Models → Add Models → Custom Endpoint, name Agent Spaghetti, API key {key}, API type Chat Completions, one model { \"id\": \"auto\", \"name\": \"Agent Spaghetti\", \"url\": \"{url}/chat/completions\", \"toolCalling\": true }; and in settings.json \"chat.agentHost.byokModels.enabled\": true (Copilot sessions list it only then).",
      "auto": {
        "config": "%APPDATA%/Code/User/chatLanguageModels.json",
        "entry": {
          "name": "Agent Spaghetti",
          "vendor": "customendpoint",
          "apiKey": "{key}",
          "apiType": "chat-completions",
          "models": [
            {
              "id": "auto",
              "name": "Agent Spaghetti",
              "url": "{url}/chat/completions",
              "toolCalling": true,
              "vision": false,
              "maxInputTokens": 32768,
              "maxOutputTokens": 4096
            }
          ]
        },
        "settings": {
          "file": "%APPDATA%/Code/User/settings.json",
          "values": {
            "chat.agentHost.byokModels.enabled": true
          }
        }
      }
    }
  }
}
