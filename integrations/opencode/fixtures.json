[
  {
    "name": "desktop app (uninstall entry + process)",
    "env": {
      "inventory": {
        "installed": [
          {
            "name": "OpenCode 1.19.0",
            "location": "C:/Users/u/AppData/Local/Programs/opencode-desktop",
            "version": "1.19.0",
            "source": "uninstall"
          }
        ],
        "processes": [
          {
            "name": "OpenCode",
            "pid": 5,
            "path": "C:/Users/u/AppData/Local/Programs/opencode-desktop/OpenCode.exe"
          }
        ]
      }
    },
    "expect": {
      "version": "1.19.0",
      "installs": 2,
      "connected": false
    }
  },
  {
    "name": "found",
    "env": {
      "kind": "linux",
      "bins": {
        "opencode": "/home/u/.local/bin/opencode"
      },
      "exec": {
        "/home/u/.local/bin/opencode --version": {
          "code": 0,
          "stdout": "1.4.2\n",
          "stderr": ""
        }
      }
    },
    "expect": {
      "installs": 1,
      "version": "1.4.2"
    }
  },
  {
    "name": "model set in its config (comments allowed): free one is free",
    "env": {
      "bins": {
        "opencode": "C:/Users/u/bin/opencode.exe"
      },
      "files": {
        "~/.config/opencode/opencode.json": "// c\n{\"model\":\"openrouter/vendor/m:free\"}"
      }
    },
    "expect": {
      "cost": "free",
      "fallback": null,
      "why": "set to openrouter/vendor/m:free"
    }
  },
  {
    "name": "model set that is not free: unknown (asks first)",
    "env": {
      "bins": {
        "opencode": "C:/Users/u/bin/opencode.exe"
      },
      "files": {
        "~/.config/opencode/opencode.json": "{\"model\":\"openrouter/vendor/paid\"}"
      }
    },
    "expect": {
      "cost": "unknown",
      "fallback": null
    }
  },
  {
    "name": "no model set: its free default is passed to tasks",
    "env": {
      "bins": {
        "opencode": "C:/Users/u/bin/opencode.exe"
      },
      "files": {
        "~/.config/opencode/opencode.json": "{}"
      }
    },
    "expect": {
      "cost": "free",
      "fallback": "opencode/big-pickle"
    }
  },
  {
    "name": "no model set but an OpenRouter key stored: the free router on that key",
    "env": {
      "bins": {
        "opencode": "C:/Users/u/bin/opencode.exe"
      },
      "files": {
        "~/.config/opencode/opencode.json": "{}",
        "~/.local/share/opencode/auth.json": "{\"openrouter\":{\"type\":\"api\",\"key\":\"k\"}}"
      }
    },
    "expect": {
      "cost": "free",
      "fallback": "openrouter/openrouter/free",
      "absent": [
        "\"k\""
      ]
    }
  },
  {
    "name": "absent",
    "env": {},
    "expect": null
  }
]
