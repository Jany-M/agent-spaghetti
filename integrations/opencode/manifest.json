{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "opencode",
  "name": "OpenCode",
  "roles": [
    "agent",
    "client"
  ],
  "cost": "unknown",
  "detect": {
    "installed": [
      "OpenCode*"
    ],
    "process": [
      "opencode"
    ],
    "bin": [
      "opencode"
    ],
    "version": {
      "args": [
        "--version"
      ]
    }
  },
  "speaks": {
    "mcpClient": {
      "config": "~/.config/opencode/opencode.json",
      "key": "mcp",
      "entry": {
        "type": "local",
        "enabled": true
      },
      "commandArray": true
    }
  }
}
