{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "opencode",
  "name": "OpenCode",
  "abilities": [
    "web"
  ],
  "roles": [
    "agent",
    "client"
  ],
  "cost": "unknown",
  "uses": {
    "config": "~/.config/opencode/opencode.json",
    "model": "model",
    "free": "opencode/big-pickle",
    "keyed": {
      "file": "~/.local/share/opencode/auth.json",
      "key": "openrouter.key",
      "free": "openrouter/openrouter/free"
    }
  },
  "detect": {
    "installed": [
      "OpenCode*"
    ],
    "process": [
      "opencode"
    ],
    "bin": [
      "opencode"
    ],
    "version": {
      "args": [
        "--version"
      ]
    }
  },
  "speaks": {
    "acp": {
      "command": [
        "opencode",
        "acp"
      ]
    },
    "mcpClient": {
      "config": "~/.config/opencode/opencode.json",
      "key": "mcp",
      "entry": {
        "type": "local",
        "enabled": true
      },
      "commandArray": true
    },
    "openaiClient": {
      "setup": "In ~/.config/opencode/opencode.json (the global one), add a provider:\n\"provider\": { \"agent-spaghetti\": { \"npm\": \"@ai-sdk/openai-compatible\", \"name\": \"Agent Spaghetti\", \"options\": { \"baseURL\": \"{url}\", \"apiKey\": \"{key}\" }, \"models\": { \"auto\": { \"name\": \"Agent Spaghetti (auto)\" } } } }\nThen pick agent-spaghetti/auto as the model in OpenCode. Which LLM answers is chosen in Agent Spaghetti (Tools → OpenCode → Model)."
    }
  }
}
