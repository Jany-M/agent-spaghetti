{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "claude-desktop",
  "name": "Claude Desktop",
  "roles": [
    "client"
  ],
  "cost": "metered",
  "platforms": [
    "windows",
    "macos"
  ],
  "detect": {
    "installed": [
      "Claude"
    ],
    "version": {
      "from": "installed"
    }
  },
  "speaks": {
    "mcpClient": {
      "config": "%APPDATA%/Claude/claude_desktop_config.json",
      "key": "mcpServers"
    }
  }
}