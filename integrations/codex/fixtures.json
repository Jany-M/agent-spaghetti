[
  {
    "name": "desktop app only (no CLI): found, not a client here",
    "env": {
      "inventory": {
        "installed": [
          {
            "name": "OpenAI.Codex",
            "version": "26.1.0.0",
            "location": "C:/Program Files/WindowsApps/OpenAI.Codex",
            "source": "msix"
          }
        ]
      }
    },
    "expect": {
      "installs": 1,
      "version": "26.1.0.0",
      "why": "installed"
    }
  },
  {
    "name": "CLI on PATH: a client, connected when its config names our server",
    "env": {
      "bins": {
        "codex": "C:/Users/u/bin/codex.exe"
      },
      "files": {
        "~/.codex/config.toml": "[mcp_servers.agent-spaghetti]\ncommand = \"node\"\nargs = [\"C:/as/cli.ts\", \"mcp\", \"--as\", \"codex\"]\n"
      }
    },
    "expect": {
      "installs": 1,
      "connected": true
    }
  },
  {
    "name": "our server set up for another tool is not a connection of this one",
    "env": {
      "bins": {
        "codex": "C:/Users/u/bin/codex.exe"
      },
      "files": {
        "~/.codex/config.toml": "[mcp_servers.agent-spaghetti]\ncommand = \"node\"\nargs = [\"C:/as/cli.ts\", \"mcp\", \"--as\", \"claude-cli\"]\n"
      }
    },
    "expect": {
      "installs": 1,
      "connected": false
    }
  },
  {
    "name": "absent",
    "env": {},
    "expect": null
  }
]
