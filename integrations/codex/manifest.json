{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "codex",
  "name": "Codex",
  "roles": [
    "agent",
    "client"
  ],
  "cost": "metered",
  "detect": {
    "installed": [
      "OpenAI.Codex",
      "Codex*"
    ],
    "bin": [
      "codex"
    ],
    "version": {
      "from": "installed"
    },
    "paths": {
      "windows": [
        "{installed}/app/resources/codex.exe"
      ]
    }
  },
  "speaks": {
    "mcpCli": {
      "add": [
        "mcp",
        "add"
      ],
      "remove": [
        "mcp",
        "remove"
      ],
      "config": "~/.codex/config.toml"
    }
  }
}
