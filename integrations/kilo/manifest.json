{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "kilo",
  "name": "Kilo",
  "roles": [
    "agent",
    "client"
  ],
  "cost": "unknown",
  "detect": {
    "installed": [
      "Kilo"
    ],
    "process": [
      "kilo-desktop",
      "kilo"
    ],
    "bin": [
      "kilo"
    ],
    "paths": [
      "%LOCALAPPDATA%/KiloDesktop/app-*/resources/kilo/*/bin/kilo.exe",
      "~/.vscode/extensions/kilocode.kilo-code-*",
      "~/.vscode-insiders/extensions/kilocode.kilo-code-*",
      "~/.cursor/extensions/kilocode.kilo-code-*",
      "~/.windsurf/extensions/kilocode.kilo-code-*"
    ],
    "version": {
      "file": "~/.vscode/extensions/kilocode.kilo-code-*/package.json",
      "json": "version"
    }
  },
  "speaks": {
    "acp": {
      "command": [
        "kilo",
        "acp"
      ]
    },
    "mcpClient": {
      "config": "~/.config/kilo/kilo.jsonc",
      "key": "mcp",
      "entry": {
        "type": "local",
        "enabled": true
      },
      "commandArray": true
    },
    "openaiClient": {
      "setup": "In ~/.config/kilo/kilo.jsonc (the global one), add a provider:\n\"provider\": { \"agent-spaghetti\": { \"npm\": \"@ai-sdk/openai-compatible\", \"name\": \"Agent Spaghetti\", \"options\": { \"baseURL\": \"{url}\", \"apiKey\": \"{key}\" }, \"models\": { \"auto\": { \"name\": \"Agent Spaghetti (auto)\" } } } }\nThen pick agent-spaghetti/auto as the model in Kilo. Which LLM answers is chosen in Agent Spaghetti (Tools \u2192 Kilo \u2192 Model)."
    }
  }
}
