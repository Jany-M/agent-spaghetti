[
  {
    "name": "Kilo Desktop with its bundled CLI (newest app folder)",
    "env": {
      "inventory": {
        "installed": [
          {
            "name": "Kilo",
            "version": "0.1.12",
            "location": "C:/Users/u/AppData/Local/KiloDesktop",
            "source": "uninstall"
          }
        ]
      },
      "files": {
        "%LOCALAPPDATA%/KiloDesktop/app-*/resources/kilo/*/bin/kilo.exe": ""
      },
      "exec": {}
    },
    "expect": {
      "version": "0.1.12",
      "installs": 2,
      "connected": false
    }
  },
  {
    "name": "connected: our entry in kilo.jsonc (comments allowed)",
    "env": {
      "bins": {
        "kilo": "C:/Users/u/bin/kilo.exe"
      },
      "files": {
        "~/.config/kilo/kilo.jsonc": "{\n  // mine\n  \"mcp\": { \"agent-spaghetti\": { \"type\": \"local\" }, },\n}"
      }
    },
    "expect": {
      "connected": true
    }
  },
  {
    "name": "found",
    "env": {
      "files": {
        "~/.vscode/extensions/kilocode.kilo-code-*": "",
        "~/.vscode/extensions/kilocode.kilo-code-*/package.json": "{\"version\":\"3.1.0\"}"
      }
    },
    "expect": {
      "installs": 1,
      "version": "3.1.0"
    }
  },
  {
    "name": "absent",
    "env": {},
    "expect": null
  }
]
