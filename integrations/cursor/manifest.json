{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifest": 1,
  "id": "cursor",
  "name": "Cursor",
  "roles": [
    "client"
  ],
  "cost": "metered",
  "detect": {
    "installed": [
      "Cursor*"
    ],
    "process": [
      "Cursor"
    ],
    "bin": [
      "cursor"
    ],
    "version": {
      "from": "installed"
    }
  },
  "speaks": {
    "mcpClient": {
      "config": "~/.cursor/mcp.json",
      "key": "mcpServers"
    },
    "agentPlugins": {
      "dir": "~/.cursor/plugins/local",
      "variant": "cursor"
    }
  }
}