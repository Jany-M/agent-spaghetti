{
  "name": "agent-spaghetti",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19"
  },
  "workspaces": [
    "packages/*",
    "integrations"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "secretscan": "node scripts/secretscan.mjs",
    "licensecheck": "node scripts/licensecheck.mjs",
    "build": "node scripts/build.mjs",
    "tray": "npm run build && electron packages/app",
    "check": "npm run typecheck && npm run secretscan && npm run licensecheck && npm run build && npm test",
    "daemon": "node packages/cli/src/index.ts daemon"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
