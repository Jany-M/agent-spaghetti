{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentspaghetti.dev/schema/manifest-1.json",
  "title": "Agent Spaghetti integration manifest, version 1 (ADR 0004, ADR 0008)",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "id", "name", "roles"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "roles": { "type": "array", "minItems": 1, "items": { "enum": ["agent", "backend", "client", "tool"] } },
    "cost": { "enum": ["free", "metered", "unknown"] },
    "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] } },
    "detect": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "installed": { "type": "array", "items": { "type": "string" } },
        "process": { "type": "array", "items": { "type": "string" } },
        "processNotIn": { "type": "array", "items": { "type": "string" }, "description": "Path fragments of copies bundled inside other tools (e.g. LM Studio's own llama-server): such processes are not this tool" },
        "bin": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "paths": { "anyOf": [
          { "type": "array", "items": { "type": "string" } },
          { "type": "object", "additionalProperties": false, "properties": {
            "windows": { "type": "array", "items": { "type": "string" } },
            "linux": { "type": "array", "items": { "type": "string" } },
            "macos": { "type": "array", "items": { "type": "string" } } } } ] },
        "version": { "anyOf": [
          { "type": "object", "additionalProperties": false, "required": ["from"], "properties": { "from": { "const": "installed" } } },
          { "type": "object", "additionalProperties": false, "required": ["args"], "properties": { "args": { "type": "array", "items": { "type": "string" } }, "regex": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["file", "json"], "properties": { "file": { "type": "string" }, "json": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["json"], "properties": { "json": { "type": "string" } } } ] },
        "http": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": {
          "port": { "type": "integer" }, "path": { "type": "string", "pattern": "^/" },
          "url": { "type": "string", "pattern": "^https://", "description": "a hosted API: probed at this address (with speaks.openai.headers) once its detect.env variables are set; never by the live poll" } } }
      }
    },
    "models": {
      "type": "object", "additionalProperties": false, "required": ["list", "id"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "list": { "type": "string" },
        "id": { "type": "string" },
        "filter": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "in"],
          "properties": { "field": { "type": "string" }, "in": { "type": "array" } } } },
        "context": { "type": "array", "items": { "type": "string" } }
      }
    },
    "speaks": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "openai": { "type": "object", "additionalProperties": false, "required": ["base"], "properties": { "base": { "type": "string" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "sent with every request (probe and run); {env:NAME} is read from the environment at request time (NAME must be in detect.env)" } } },
        "openaiClient": { "type": "object", "additionalProperties": false, "required": ["setup"], "description": "the tool can use a custom OpenAI-compatible endpoint: the model gateway",
          "properties": { "setup": { "type": "string", "description": "steps for the user; {url} and {key} are filled in; the tool asks for model auto and Agent Spaghetti picks (Tools → Model)" } } },
        "mcpServer": { "type": "object", "additionalProperties": false, "required": ["command"], "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
        "acp": { "type": "object", "additionalProperties": false, "required": ["command"], "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
        "chat": { "type": "object", "additionalProperties": false, "required": ["command"], "description": "its chat takes a task: <command…> <prompt> - (task on stdin); results come back through report",
          "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
        "mcpClient": { "type": "object", "additionalProperties": false, "required": ["config", "key"], "properties": { "config": { "type": "string" }, "key": { "type": "string" },
          "entry": { "type": "object", "description": "extra fields our server entry needs, e.g. { \"type\": \"stdio\" }" },
          "commandArray": { "type": "boolean", "description": "the entry's command holds the program and its arguments as one array" } } },
        "mcpCli": { "type": "object", "additionalProperties": false, "required": ["add", "remove"], "description": "the tool's own CLI adds/removes MCP servers: <bin> <add…> agent-spaghetti -- <command…> / <bin> <remove…> agent-spaghetti",
          "properties": { "add": { "type": "array", "items": { "type": "string" } }, "remove": { "type": "array", "items": { "type": "string" } },
            "config": { "type": "string", "description": "a non-JSON config file the CLI writes; connected = it names our server" } } },
        "promptHook": { "type": "object", "additionalProperties": false, "required": ["config", "event"], "description": "the >> shortcut through the tool's prompt hook: hooks.<event>[] in a JSON settings file",
          "properties": { "config": { "type": "string" }, "event": { "type": "string" } } },
        "agentPlugins": { "type": "object", "additionalProperties": false, "required": ["dir"], "properties": { "dir": { "type": "string" }, "variant": { "enum": ["agent-plugins", "cursor"] } } }
      }
    }
  }
}
