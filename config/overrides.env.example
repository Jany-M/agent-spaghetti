# OPTIONAL. Copy to config/overrides.env (git-ignored) only if you need to change a default.
# With no file at all, the workflow adapts to whatever OpenClaw is already using.

# How to choose the LLM:
#   auto    (default) keep OpenClaw's current model while its endpoint answers; if it stops answering,
#           detect a local server (LM Studio / Ollama / llama.cpp / vLLM) and use the loaded model.
#           OpenClaw's own managed llama.cpp server and hosted APIs are simply kept.
#   keep    never touch provider or model.
#   follow  always switch to whatever local server/model is loaded right now.
#   manual  use the PROVIDER_ID / BASE_URL / MODEL_ID below.
#PROVIDER_MODE=auto

# Extra hosts to probe for a local LLM server (space separated), e.g. a GPU box on your LAN.
#LLM_HOSTS="192.168.1.50"

# Seconds one model HTTP request may take (queue wait + long prompts on a single-slot server).
#PROVIDER_TIMEOUT_SECONDS=900

# Only for PROVIDER_MODE=manual:
#PROVIDER_ID=local-ollama
#BASE_URL=http://localhost:11434/v1
#MODEL_ID=qwen3:8b
#CONTEXT_WINDOW=32768
#MAX_TOKENS=8192
#API_KEY=local

# Which agent becomes the orchestrator (default: OpenClaw's default agent).
#ORCH_AGENT_ID=main
