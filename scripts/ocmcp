#!/usr/bin/env python3
"""ocmcp - turn OpenClaw MCP servers on/off on demand (they are OFF by default).

Only toggles `enabled` through `openclaw config patch` (schema-validated, merge-only).
Never prints or copies credentials. Catalog (descriptions/keywords) lives next to the repo: mcp/catalog.json
"""
import json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
STATE = os.environ.get("OPENCLAW_STATE_DIR") or os.path.join(HOME, ".openclaw")
os.environ["PATH"] = os.pathsep.join(
    [os.path.join(STATE, "tools", "node", "bin"), os.path.join(HOME, ".local", "bin"), os.environ.get("PATH", "")])


def _config_path():
    if os.environ.get("OPENCLAW_CONFIG_PATH"):
        return os.environ["OPENCLAW_CONFIG_PATH"]
    try:
        out = subprocess.run(["openclaw", "config", "file"], capture_output=True, text=True, timeout=30).stdout.strip()
        if out:
            return os.path.expanduser(out.splitlines()[-1])
    except Exception:
        pass
    return os.path.join(STATE, "openclaw.json")


CFG = _config_path()
ORCH = os.path.join(os.path.dirname(CFG), "agent-spaghetti")


def servers():
    return json.load(open(CFG, encoding="utf-8")).get("mcp", {}).get("servers", {})


def _load(path):
    try:
        return json.load(open(path, encoding="utf-8"))
    except Exception:
        return {}


_GENERIC = _load(os.environ.get("MCP_CATALOG", os.path.join(ORCH, "mcp", "catalog.json")))
_LOCAL = _load(os.path.join(ORCH, "catalog.local.json"))


def _derive(name):
    """Last-resort description from the package name or URL host. Never touches env/headers (secrets)."""
    s = servers().get(name, {})
    if s.get("url"):
        host = re.sub(r"^https?://", "", s["url"]).split("/")[0]
        return {"summary": "remote MCP server at " + host, "keywords": [host]}
    args = [a for a in s.get("args", []) if isinstance(a, str) and not a.startswith("-") and "=" not in a and len(a) < 80]
    pkg = args[0] if args else os.path.basename(s.get("command", "") or "")
    return {"summary": "MCP server (%s)" % pkg if pkg else "MCP server", "keywords": re.split(r"[\W_]+", pkg.lower())}


def entry(name):
    if name in _LOCAL:
        return _LOCAL[name]
    low = name.lower()
    hits = [k for k in _GENERIC if not k.startswith("_") and k in low]
    if name in _GENERIC:
        return _GENERIC[name]
    if hits:
        e = dict(_GENERIC[max(hits, key=len)])
        e["keywords"] = e.get("keywords", []) + re.split(r"[\W_]+", low)  # keep qualifiers like -dev / -prod
        return e
    return _derive(name)


def catalog():
    return {n: entry(n) for n in servers()}


def patch(enabled_map):
    body = json.dumps({"mcp": {"servers": {k: {"enabled": v} for k, v in enabled_map.items()}}})
    r = subprocess.run(["openclaw", "config", "patch", "--stdin"], input=body, text=True, capture_output=True)
    if r.returncode != 0:
        sys.exit("config patch failed: " + (r.stderr or r.stdout)[-600:])


def reload_():
    subprocess.run(["openclaw", "mcp", "reload"], capture_output=True, text=True)


def known(names):
    s = servers()
    bad = [n for n in names if n not in s]
    if bad:
        sys.exit("unknown server(s): %s. Known: %s" % (", ".join(bad), ", ".join(sorted(s))))


def cmd_list(_):
    cat, s = catalog(), servers()
    for n in sorted(s):
        on = s[n].get("enabled", True)
        c = cat.get(n, {})
        flag = "ON " if on else "off"
        note = (" [BROKEN: %s]" % c["broken"]) if c.get("broken") else ""
        print("%s  %-26s %s%s" % (flag, n, c.get("summary", "(no catalog entry)"), note))


def cmd_search(a):
    words = [w.lower() for w in re.split(r"\W+", " ".join(a)) if w]
    cat, s = catalog(), servers()
    scored = []
    for n in s:
        c = cat.get(n, {})
        hay = (n + " " + c.get("summary", "") + " " + " ".join(c.get("keywords", []))).lower()
        sc = sum(hay.count(w) for w in words)
        if sc:
            scored.append((sc, n))
    for sc, n in sorted(scored, reverse=True)[:6]:
        c = cat.get(n, {})
        print("%-26s %s%s" % (n, c.get("summary", ""), "  [BROKEN: %s]" % c["broken"] if c.get("broken") else ""))
    if not scored:
        print("no match; run: ocmcp list")


def cmd_on(a):
    known(a)
    cat = catalog()
    for n in a:
        if cat.get(n, {}).get("broken"):
            print("WARNING: %s is marked broken: %s" % (n, cat[n]["broken"]))
    patch({n: True for n in a})
    reload_()
    print("enabled: " + ", ".join(a))


def cmd_off(a):
    known(a)
    patch({n: False for n in a})
    reload_()
    print("disabled: " + ", ".join(a))


def cmd_off_all(_):
    s = servers()
    on = [n for n in s if s[n].get("enabled", True)]
    if on:
        patch({n: False for n in s})
        reload_()
    print("all MCP servers off (was on: %s)" % (", ".join(on) or "none"))


def cmd_probe(a):
    known(a)
    r = subprocess.run(["openclaw", "mcp", "probe"] + a, text=True, capture_output=True, timeout=120)
    out = re.sub(r"\x1b\[[0-9;]*m", "", r.stdout + r.stderr)
    print(out[-3000:])


def cmd_status(_):
    s = servers()
    print("on : " + (", ".join(n for n in sorted(s) if s[n].get("enabled", True)) or "none"))
    print("off: %d servers" % sum(1 for n in s if not s[n].get("enabled", True)))


CMDS = {"list": cmd_list, "search": cmd_search, "on": cmd_on, "off": cmd_off,
        "off-all": cmd_off_all, "probe": cmd_probe, "status": cmd_status}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__ + "\ncommands: " + ", ".join(CMDS))
        sys.exit(2)
    CMDS[sys.argv[1]](sys.argv[2:])
